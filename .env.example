# Copy to .env (gitignored) and replace every placeholder. Local development only.

# Read by deploy/compose.yaml (make up). Keep passwords URL-safe (letters, digits, - _ .):
# the stack puts them into connection URLs. Postgres reads them only on its first start.
POSTGRES_PASSWORD=change-me-superuser
JOBHUNT_OWNER_PASSWORD=change-me-owner
JOBHUNT_APP_PASSWORD=change-me-app

# The stack builds its own connection URLs from the passwords above. These two are for
# running a binary on the Mac against the stack's Postgres (go run ./cmd/...).
# Migrations connect as the owner role (go run ./cmd/migrate up).
MIGRATIONS_DATABASE_URL=postgres://jobhunt_owner:change-me-owner@localhost:5432/jobhunt?sslmode=disable
# Everything else connects as the app role.
DATABASE_URL=postgres://jobhunt_app:change-me-app@localhost:5432/jobhunt?sslmode=disable

# The one Lever board `go run ./cmd/collector once` fetches (M0-04).
COLLECTOR_LEVER_COMPANY=spotify

# Leads API (go run ./cmd/api). Loopback by default: the API has no auth (ADR-0002).
API_ADDR=127.0.0.1:8080

# Where `make backup` writes (outside the repository). Default ~/job-hunter-backups.
# JOBHUNT_BACKUP_DIR=/Users/you/job-hunter-backups

# The Python worker's model calls (M3-03, ADR-0018). Empty: no model work. Never commit a
# real key; .env is git-ignored.
ANTHROPIC_API_KEY=
# Today's (UTC) model cost at which the worker stops claiming work until the next day.
MODEL_DAILY_BUDGET_USD=1.00
