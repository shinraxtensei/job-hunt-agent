# --- Go (GitHub template) ---
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
# a Python module (M4-03), not a coverage report
!agents/src/jobhunt_agents/coverage.py
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.pyright/

# --- Node ---
node_modules/
# vite build output, embedded by internal/webui (dist/.gitkeep is committed)
/internal/webui/dist/app/
/web/test-results/
/web/playwright-report/

# --- Env and secrets ---
.env
.env.*
!.env.example

# --- Local tool settings (per machine) ---
.claude/settings.local.json

# --- OS / editors ---
.DS_Store
.idea/
.vscode/

# --- Personal data (M3-05): the real profile stays on the owner's machine; the
# *.example.yaml files show the format.
/data/profile/*
!/data/profile/*.example.yaml
# The eval set's posting texts (M3-07); its labels and recorded runs are committed.
/agents/evals/postings/
# eval runs that reveal the profile (M3-06 reasons)
/agents/evals/private/

# TypeScript build info (tsc -b); type checking never emits (web/tsconfig.json noEmit)
/web/*.tsbuildinfo
